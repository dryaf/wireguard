// Managed by the WireGuard project. Match the installed release, not a moving suite.
{% if ansible_facts.distribution == 'Debian' %}
Unattended-Upgrade::Origins-Pattern {
    "origin=Debian,codename=${distro_codename},label=Debian";
    "origin=Debian,codename=${distro_codename},label=Debian-Security";
    "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
    "origin=Debian-Security,codename=${distro_codename}-security,label=Debian-Security";
};
{% else %}
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}";
    "${distro_id}:${distro_codename}-security";
    "${distro_id}ESMApps:${distro_codename}-apps-security";
    "${distro_id}ESMApps:${distro_codename}-apps-legacy-security";
    "${distro_id}ESM:${distro_codename}-infra-security";
    "${distro_id}ESM:${distro_codename}-infra-legacy-security";
};
{% endif %}
